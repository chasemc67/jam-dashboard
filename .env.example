# Local secrets — copy to `.env` (never commit `.env`)

# Required for the in-app Agent chat overlay. Create a key in the Vercel AI Gateway:
# https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# Optional AI Gateway model id for Agent chat (default: openai/gpt-5.4-mini)
# JAM_AGENT_CHAT_MODEL=openai/gpt-5.4-mini

# Set automatically by `npm run agent:dev`. Do not put tokens in git.
# JAM_AGENT_URL=http://127.0.0.1:4178/mcp
# JAM_AGENT_TOKEN=
