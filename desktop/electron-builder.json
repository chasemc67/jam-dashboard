{
  "appId": "com.jamdashboard.desktop",
  "productName": "Jam Dashboard",
  "directories": {
    "app": "desktop",
    "output": "release"
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "policy.cjs",
    "analyzer.cjs",
    "tracker.cjs",
    "recording.cjs",
    "agent-service.cjs",
    "updater.cjs",
    "electron-updater.cjs",
    "renderer/client/**/*",
    "package.json",
    "!**/node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "desktop/native/dist/${arch}/MusicAnalyzerCLI",
      "to": "MusicAnalyzerCLI"
    },
    {
      "from": "desktop/native/dist/${arch}/FretTrackerCLI",
      "to": "FretTrackerCLI"
    },
    {
      "from": "desktop/native/dist/FretTrackerV1.mlmodelc",
      "to": "FretTrackerV1.mlmodelc"
    },
    {
      "from": "desktop/native/dist/FretTrackerV3.mlmodelc",
      "to": "FretTrackerV3.mlmodelc"
    },
    {
      "from": "desktop/native/dist/FretTrackerV4Q832.mlmodelc",
      "to": "FretTrackerV4Q832.mlmodelc"
    }
  ],
  "mac": {
    "icon": "desktop/assets/JamDashboard.icns",
    "category": "public.app-category.music",
    "target": ["dmg", "zip"],
    "minimumSystemVersion": "13.0",
    "hardenedRuntime": true,
    "entitlements": "desktop/entitlements.mac.plist",
    "entitlementsInherit": "desktop/entitlements.mac.plist",
    "notarize": false,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Jam Dashboard listens to your instrument to detect notes.",
      "NSCameraUsageDescription": "Jam Dashboard uses the camera to track your guitar's fretboard and draw scales on it. Video stays on your Mac."
    }
  },
  "afterSign": "./desktop/notarize.cjs",
  "artifactName": "Jam-Dashboard-${version}-${arch}.${ext}",
  "publish": [
    {
      "provider": "github",
      "owner": "chasemc67",
      "repo": "jam-dashboard",
      "releaseType": "release"
    }
  ]
}
